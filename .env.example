# ---- Telegram ----
# Token gerado pelo @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=123456789:AAH-seu-token-aqui

# Seu chat_id: o bot só responde a ele. Descubra mandando /start para o @userinfobot.
ALLOWED_CHAT_ID=123456789

# ---- Infra ----
# SQLite em dev. Em produção: postgresql+asyncpg://user:senha@host:5432/assistant
DATABASE_URL=sqlite+aiosqlite:///./data/assistant.db

# Fuso usado para interpretar e exibir datas (no banco tudo fica em UTC)
TIMEZONE=America/Sao_Paulo

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text (legível, para dev) | json (estruturado, para produção)
LOG_FORMAT=text

# ---- Lembretes ----
# Hora usada quando o lembrete não informa horário (0-23)
REMINDER_DEFAULT_HOUR=9
# De quantos em quantos segundos o bot verifica avisos pendentes (mínimo 5)
REMINDER_POLL_SECONDS=30